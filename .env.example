# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for production.
#
# The contact form needs AT LEAST ONE of the two delivery targets below.
# With neither configured, POST /api/contact returns 502 rather than
# pretending the enquiry was received.

# --- Supabase (stores enquiries) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Project Settings → API → service_role key. Server-only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (emails enquiries) ---
RESEND_API_KEY=
# Optional overrides. FROM must be a domain verified in Resend; the default
# onboarding@resend.dev sandbox sender only delivers to your own account email.
CONTACT_TO_EMAIL=sathyarajeshpk@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Site ---
# Used for canonical URLs, sitemap, robots, and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://sathyarajeshpk.com

# --- Analytics (optional) ---
# Scripts are only injected when these are set, so leaving them blank is safe.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
